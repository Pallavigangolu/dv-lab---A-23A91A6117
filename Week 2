#Load Air Passengers Data Set
data("AirPassengers")
?AirPassengers
#verify the dataset

class(AirPassengers)
View(AirPassengers)

ap_df <- data.frame(
  year <- time(AirPassengers),
  
  
  
  
  
  #Data Frame with Years and months seperately 
  ap_df_months <- data.frame(
    year = floor(time(AirPassengers)),
    month = cycle(time(AirPassengers)),
    passengers = as.numeric(AirPassengers)
  )
  ap_df_months
  
  #Basic plot
  plot(AirPassengers)
  
  #Plot with Title, Axix labels and color
  plot(AirPassengers,
       type = 'l',
       main = "Air Passengers Trend Analysis",
       xlab = "Months",
       ylab = "No of Passengers",
       col = "red"
  )
  
  #changing the line Width & point 
  plot(AirPassengers,
       type = 'l',
       lwd = 1.5,
       main = "Air Passengers Trend Analysis",
       xlab = "Months",
       ylab = "No of Passengers",
       col = "red"
  )
  points(AirPassengers,
         type = 'o',
         pch = 16,
         col = "blue")
  grid()
  
  #Using GGPLOT2 Library
  #importing the library ggplot2
  lbrary(ggplot2)
  #A basic Grid with x & y axes
  ggplot(ap_df,
         aes(x  =year, y=passengers))+
    geom_line(color="darkgreen", linewidth = 0.5) + 
    labs(
      title = 'Trend Analysis of Air Passengers',
      subtitle = 'From 1949-1960',
      caption = 'Using Built-in Air Passengers Dataset',
      x = 'Months',
      y = 'No of Passengers') +
    geom_point(color = 'red', size=0.5)+
    geom_smooth(se=FALSE,color = 'orange') +
    theme_minimal()+
    theme(
      plot.title = element_text(face = "bold", size = 14),
      plot.subtitle = element_text(aize = 10))

 
